# RankMonk website: environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production).
# Values are read on the server at build time; pages are statically generated,
# so changing a variable requires a redeploy. Only the GA4 ID and the Search
# Console token end up in public HTML (by design). Everything else stays on the server.

# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin for canonical URLs, sitemap, robots, Open Graph and JSON-LD.
# Absolute URL, lowercase, no trailing slash.
SITE_URL=https://rankmonk.io
SITE_NAME=RankMonk
# Organisation description (structured data, llms.txt, web manifest)
SITE_DESCRIPTION=RankMonk is a local SEO and AI search visibility platform for local businesses, multi-location brands and agencies in India. Track Google Maps rank street by street, protect Google Business Profiles, reply to reviews with AI, keep listings right on 20+ directories and see whether ChatGPT and Gemini recommend you.
# Open Graph locale and <html lang>
SITE_LOCALE=en_IN
SITE_LANGUAGE=en-IN
# Customer login link
DASHBOARD_URL=https://dashboard.rankmonk.io

# ── SEO (home page + defaults) ──────────────────────────────────────────
# Other pages have their own titles/descriptions from the page content.
DEFAULT_TITLE=RankMonk: Local SEO & AI Search Visibility Platform
DEFAULT_DESCRIPTION=Track Google Maps rank street by street, protect Google Business Profiles, reply to reviews with AI and see if ChatGPT and Gemini recommend you.
# Comma separated
DEFAULT_KEYWORDS=local SEO, local SEO software India, Google Business Profile management, geo-grid rank tracker, Google Maps ranking, review management, AI review replies, listings management, AI search visibility, ChatGPT visibility, multi-location SEO, local SEO for agencies
# Social sharing image (1200×630) for Open Graph and X/Twitter previews.
# Absolute URL or site path. /og.png is generated by the site.
OG_IMAGE=/og.png
# Set to false to noindex/nofollow the whole site (staging). Vercel preview
# deployments are always noindex regardless of these values.
ROBOTS_INDEX=true
ROBOTS_FOLLOW=true

# ── Google ──────────────────────────────────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Analytics is disabled when empty.
GA4_MEASUREMENT_ID=
# Search Console HTML-tag verification: only the content="…" value of the meta tag.
GOOGLE_SEARCH_CONSOLE_VERIFICATION=

# ── Contact details shown on the site ───────────────────────────────────
PUBLIC_PHONE=+91 88717 19169

# ── Google Sheets (server-only secrets) ─────────────────────────────────
# Demo requests go to the "Demo requests" tab and newsletter signups to the
# "Newsletter" tab. Setup: README → "Google Sheets setup".
# Apps Script web app URL (ends in /exec)
GOOGLE_SHEETS_WEBHOOK_URL=
# Long random string; must equal the SECRET script property in Apps Script
GOOGLE_SHEETS_SECRET=

# ── Social profiles (optional; Organization structured data "sameAs") ────
LINKEDIN_URL=
INSTAGRAM_URL=
FACEBOOK_URL=

# ── Blog (server-only secrets) ──────────────────────────────────────────
# Supabase project URL (Settings → API → Project URL), e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase service role / secret key (Settings → API). Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token for POST/PATCH/DELETE /api/blog/posts (min 32 chars). Used by the daily routine.
BLOG_API_TOKEN=
