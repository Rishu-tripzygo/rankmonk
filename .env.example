# RankMonk website — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production and Preview).
# All values are read on the server at build time; pages are statically generated,
# so changing a variable requires a redeploy. Nothing here is exposed to the browser
# unless noted (GA4 ID and the Search Console token end up in public HTML by design).

# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin used for canonical URLs, sitemap, robots, Open Graph and JSON-LD.
# Must be an absolute URL, no trailing slash. Default: https://rankmonk.io
SITE_URL=https://rankmonk.io
SITE_NAME=RankMonk
SITE_DESCRIPTION=
# Open Graph locale and <html lang>. Defaults: en_IN / en-IN
SITE_LOCALE=en_IN
SITE_LANGUAGE=en-IN
# Customer login link. Default: https://dashboard.rankmonk.io
DASHBOARD_URL=https://dashboard.rankmonk.io

# ── SEO ─────────────────────────────────────────────────────────────────
# Home page title/description and default keywords (comma separated). Optional.
DEFAULT_TITLE=
DEFAULT_DESCRIPTION=
DEFAULT_KEYWORDS=
# Social sharing images (absolute URL or site path). Default: /og.png (generated)
OG_IMAGE=
TWITTER_IMAGE=
# e.g. @rankmonk (optional)
TWITTER_HANDLE=
# Set to false to noindex/nofollow the whole site (staging). Vercel preview
# deployments are always noindex regardless of these values.
ROBOTS_INDEX=true
ROBOTS_FOLLOW=true

# ── Google ──────────────────────────────────────────────────────────────
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Analytics is disabled when empty.
GA4_MEASUREMENT_ID=
# Search Console HTML-tag verification: only the content="…" value of the meta tag.
GOOGLE_SEARCH_CONSOLE_VERIFICATION=

# ── Contact details shown on the site ───────────────────────────────────
# Defaults come from the design reference.
PUBLIC_EMAIL=legal@rankmonk.io
PUBLIC_PHONE=+91 88717 19169

# ── Email (server-only secrets) ─────────────────────────────────────────
# Demo requests and newsletter signups are delivered with Resend (https://resend.com).
# The forms return a friendly error until RESEND_API_KEY, EMAIL_FROM and CONTACT_EMAIL are set.
RESEND_API_KEY=
# Verified sender, e.g. "RankMonk <hello@rankmonk.io>" (domain must be verified in Resend)
EMAIL_FROM=
# Inbox that receives demo requests (and newsletter signups if no audience is set)
CONTACT_EMAIL=
# Default Reply-To for outgoing mail (optional; demo requests reply to the visitor)
EMAIL_REPLY_TO=
# Resend audience ID for newsletter contacts (optional)
RESEND_AUDIENCE_ID=

# ── Social profiles (optional; used in Organization structured data "sameAs") ──
LINKEDIN_URL=
TWITTER_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
YOUTUBE_URL=
